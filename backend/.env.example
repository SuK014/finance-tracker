# Copy to .env and fill in. Never commit .env.

# Any PostgreSQL database (local, Supabase, Neon, ...)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ngerntong

# Required: the API refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: e-slip scanning and voice entry. Without a key those features fail; everything else works.
# "claude" needs ANTHROPIC_API_KEY, "gemini" needs GEMINI_API_KEY.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# Optional
# PORT=3001
# CORS_ORIGIN=http://localhost:3000   (comma-separate several origins)
