generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int                    @id @default(autoincrement())
  email        String                 @unique
  passwordHash String
  createdAt    DateTime               @default(now())
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  recurring    RecurringTransaction[]
  assetLots    AssetLot[]
  goals        Goal[]
  bonds        Bond[]
}

model Category {
  id           Int                    @id @default(autoincrement())
  userId       Int
  name         String
  color        String?
  icon         String?
  type         String                 @default("expense")
  budget       Float?
  deletedAt    DateTime?
  user         User                   @relation(fields: [userId], references: [id])
  transactions Transaction[]
  recurring    RecurringTransaction[]

  @@index([userId])
}

model Account {
  id           Int                    @id @default(autoincrement())
  userId       Int
  name         String
  type         String
  currency     String                 @default("THB")
  bankName     String?
  deletedAt    DateTime?
  user         User                   @relation(fields: [userId], references: [id])
  transactions Transaction[]
  recurring    RecurringTransaction[]
  assetLots    AssetLot[]
  goalEntries  GoalEntry[]

  @@index([userId])
}

model Transaction {
  id          Int       @id @default(autoincrement())
  userId      Int
  amount      Float
  type        String
  description String?
  date        DateTime
  accountId   Int
  categoryId  Int?
  evidenceUrl String?
  // "investment" for the cash side of a portfolio buy/sell; kept out of spending and income totals.
  source      String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
  account     Account   @relation(fields: [accountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  assetLot    AssetLot?
  goalEntry   GoalEntry?

  @@index([userId])
}

model RecurringTransaction {
  id          Int       @id @default(autoincrement())
  userId      Int
  amount      Float
  type        String
  description String?
  accountId   Int
  categoryId  Int?
  frequency   String
  nextDate    DateTime
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  account     Account   @relation(fields: [accountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

// Shared reference data — the same ticker (e.g. AAPL) is the same Asset row
// for every user. A user's actual position is the AssetLot, which IS scoped.
model Asset {
  id        Int        @id @default(autoincrement())
  symbol    String     @unique
  name      String
  type      String     @default("stock")
  currency  String     @default("USD")
  deletedAt DateTime?
  lots      AssetLot[]
}

model AssetLot {
  id        Int       @id @default(autoincrement())
  userId    Int
  assetId   Int
  lotType   String
  quantity  Float
  price     Float
  date      DateTime  @default(now())
  deletedAt DateTime?
  // Optional link to the account the cash moved through, and the transaction that recorded it.
  accountId     Int?
  transactionId Int?         @unique
  user          User         @relation(fields: [userId], references: [id])
  asset         Asset        @relation(fields: [assetId], references: [id])
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// A savings goal. Money "set aside" for it stays in a real account; see GoalEntry.
model Goal {
  id        Int         @id @default(autoincrement())
  userId    Int
  name      String
  icon      String?
  target    Float
  deadline  DateTime?
  // Pay-yourself-first rule applied when a salary is received: "fixed" (baht) or "percent" of the salary.
  ruleType  String?
  ruleValue Float?
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  user      User        @relation(fields: [userId], references: [id])
  entries   GoalEntry[]

  @@index([userId])
}

// Money moved in or out of a goal. amount > 0 sets money aside in accountId; amount < 0 takes it back
// ("withdraw") or spends it ("spend", with the expense it created in transactionId).
model GoalEntry {
  id            Int          @id @default(autoincrement())
  userId        Int
  goalId        Int
  accountId     Int
  amount        Float
  kind          String
  transactionId Int?         @unique
  date          DateTime     @default(now())
  deletedAt     DateTime?
  goal          Goal         @relation(fields: [goalId], references: [id])
  account       Account      @relation(fields: [accountId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([accountId])
}

